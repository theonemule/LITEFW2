#!/bin/sh
# LiteFW installer: Alpine disk/keyboard/time/repositories with appliance hooks.
# The user runs exactly one installer. Root password remains unset; only the
# independently managed web UI administrator account is prompted.
set -eu
stock=/usr/sbin/setup-alpine
[ -x "$stock" ] || { echo 'Alpine setup-alpine is unavailable.' >&2; exit 1; }
for command in /usr/sbin/litefw-network /usr/sbin/litefw-admin; do
  [ -x "$command" ] || { echo "Missing LiteFW component: $command" >&2; exit 1; }
done
temp=$(mktemp /tmp/litefw-alpine.XXXXXX)
trap 'rm -f "$temp"' EXIT HUP INT TERM
# Guard upstream structure: never fall through to its unbounded interface/DHCP
# wizard if Alpine changes the install script.
if ! awk '
  BEGIN { network=0; disk=0; skip=0 }
  /^# set Interface$/ {
    print "echo \"== LiteFW: WAN, LAN and optional VLAN ==\""
    print "/usr/sbin/litefw-network || exit 1"
    network=1; skip=1; next
  }
  skip && /^# set root password$/ { skip=0 }
  skip { next }
  /^[[:space:]]*print_heading2 " Disk & Install"[[:space:]]*$/ && !disk {
    print "echo \"== LiteFW: web UI administrator ==\""
    print "/usr/sbin/litefw-admin || exit 1"
    disk=1
  }
  { print }
  END { if (!network || !disk || skip) exit 42 }
' "$stock" >"$temp"; then
  echo 'Alpine installer layout changed; refusing unsafe network setup.' >&2
  exit 1
fi
chmod 0700 "$temp"
echo 'LiteFW appliance installation'
echo 'Alpine will configure keyboard, timezone, repositories and target disk.'
echo 'LiteFW will configure ONLY WAN, LAN, optional LAN VLAN and web credentials.'
echo 'A root password is not required for the local appliance console.'
"$temp" -e "$@"
