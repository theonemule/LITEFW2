#!/bin/sh
# LiteFW appliance installer. Alpine supplies low-level tools only.
# A selected target disk and a completed sys-mode install are mandatory.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

die() { echo "LiteFW installation FAILED: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "Run from the local administrative console."
for tool in litefw-network litefw-admin setup-disk setup-keymap setup-timezone setup-apkrepos lsblk; do
  command -v "$tool" >/dev/null 2>&1 || die "Missing required component: $tool"
done

echo
echo '=========================================================='
echo '               LiteFW Firewall Installation'
echo '=========================================================='
echo 'This installer partitions, formats and installs LiteFW onto'
echo 'one disk you explicitly select. The disk WILL BE ERASED.'
echo 'The account you create is for the LiteFW WEB UI, not Linux.'
echo 'No Alpine network, Unix user, or Unix password wizard runs.'
echo

# Never allow Alpine setup-disk to return success on "none" or no disks.
available_disks=$(lsblk -dnpo NAME,SIZE,TYPE 2>/dev/null | awk '$3=="disk" && $1 ~ /^\/dev\/(sd[a-z]+|vd[a-z]+|xvd[a-z]+|hd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$/ {print $1 " " $2}') ||
  die "Cannot enumerate installation disks."
[ -n "$available_disks" ] || die "No installation disk detected. No changes made."

echo '[1/6] SELECT TARGET DISK'
echo 'Available installation disks (CD/DVD and loop devices excluded):'
printf '%s\n' "$available_disks" | awk '{printf "  %d) %-18s %s\n", NR, $1, $2}'
disk_count=$(printf '%s\n' "$available_disks" | awk 'END {print NR}')
selected=''
if [ -n "${LITEFW_INSTALL_DISK:-}" ]; then
  selection=$LITEFW_INSTALL_DISK
else
  while :; do
    if [ "$disk_count" -eq 1 ]; then
      printf 'Disk number or device path [1] (or cancel): '
    else
      printf 'Disk number or device path (or cancel): '
    fi
    IFS= read -r selection || die "Disk selection interrupted; no disk erased."
    [ -n "$selection" ] || {
      if [ "$disk_count" -eq 1 ]; then selection=1
      else echo 'Select one disk explicitly.' >&2; continue
      fi
    }
    case "$selection" in cancel|abort|none) die 'Installation cancelled; no disk erased.' ;; esac
    break
  done
fi

case "$selection" in
  *[!0-9]*|'') selected=$selection ;;
  *) selected=$(printf '%s\n' "$available_disks" | awk -v n="$selection" 'NR==n {print $1}') ;;
esac
[ -n "$selected" ] || die "Invalid disk selection '$selection'."
disk=$(printf '%s\n' "$available_disks" | awk -v target="$selected" '$1==target {print $1}')
[ -n "$disk" ] && [ -b "$disk" ] || die "Selected disk is not a usable block disk: $selected"
echo "Selected target: $disk"
echo 'Other drives will not be partitioned.'

if [ "${LITEFW_INSTALL_SKIP_REGIONAL:-0}" != 1 ]; then
  echo
  echo '[2/6] KEYBOARD AND TIMEZONE'
  setup-keymap || die 'Keyboard configuration failed.'
  setup-timezone || die 'Timezone configuration failed.'
fi

echo
echo '[3/6] LITEFW WAN / LAN INTERFACE ASSIGNMENT'
/usr/sbin/litefw-network || die 'LiteFW WAN/LAN configuration failed.'

# ISO package repository remains usable offline.
if [ -d /media/cdrom/apks ]; then
  if ! grep -q '^/media/cdrom/apks' /etc/apk/repositories 2>/dev/null; then
    printf '%s\n' /media/cdrom/apks >>/etc/apk/repositories
  fi
fi
echo
echo '[4/6] PACKAGE REPOSITORIES'
if grep -q '^/media/.*/apks' /etc/apk/repositories 2>/dev/null; then
  echo 'LiteFW installation ISO provides all required offline packages.'
  printf 'Add or change internet APK mirrors? [no]: '
  IFS= read -r repositories || die 'Repository configuration interrupted.'
  case "$repositories" in
    y|Y|yes|YES) setup-apkrepos || die 'APK repository setup failed.' ;;
    ''|n|N|no|NO) : ;;
    *) die 'Invalid APK mirror response.' ;;
  esac
else
  echo 'No ISO package repository found; online mirror setup is required.'
  setup-apkrepos || die 'APK repository setup failed.'
fi

echo
echo '[5/6] LITEFW WEB ADMINISTRATOR (NOT AN ALPINE USER)'
/usr/sbin/litefw-admin || die 'Web administrator setup failed.'
[ -s /etc/litefwm/htpasswd ] || die 'Web administrator credentials were not written.'

echo
echo '[6/6] PARTITION, FORMAT AND INSTALL LITEFW'
printf 'TARGET: %s\n' "$disk"
lsblk -dno NAME,SIZE,TYPE "$disk" || die 'Could not recheck selected disk.'
echo 'ALL DATA ON THIS DISK WILL BE DESTROYED.'
printf 'Type ERASE to partition, format and install LiteFW onto %s: ' "$disk"
IFS= read -r approval || die 'Install confirmation interrupted.'
[ "$approval" = ERASE ] || die 'Install was not confirmed; disk unchanged.'
echo "Starting full LiteFW sys-mode installation on $disk ..."
if ! setup-disk -m sys -s 0 "$disk"; then
  die "Disk installation failed for $disk."
fi
# setup-disk returns 0 on no-op paths. Require a real partition table.
if ! lsblk -nr -o TYPE "$disk" | grep -qx part; then
  die "Disk installer returned without creating partitions on $disk."
fi

echo
echo '=========================================================='
echo "SUCCESS: LiteFW installed to $disk"
echo 'System partitions were created and the operating system installed.'
echo 'Remove/eject the LiteFW installation ISO, then reboot.'
echo 'Log into the web UI with your LiteFW administrator credentials.'
echo '=========================================================='