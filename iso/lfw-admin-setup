#!/bin/sh
# Run during setup-alpine, before setup-disk copies the configuration.
set -eu
[ "$(id -u)" -eq 0 ] || { echo "Run as root" >&2; exit 1; }
command -v htpasswd >/dev/null 2>&1 || { echo 'apache2-utils is required' >&2; exit 1; }

if [ -t 0 ]; then
  saved=$(stty -g)
  trap 'stty "$saved"' EXIT HUP INT TERM
  stty -echo
fi
while :; do
  printf 'LiteFW2 web admin password (12+ characters): ' >&2
  IFS= read -r password || exit 1
  printf '\n' >&2
  if [ "${#password}" -lt 12 ]; then
    echo 'Password must contain at least 12 characters.' >&2
    continue
  fi
  printf 'Confirm LiteFW2 web admin password: ' >&2
  IFS= read -r confirm || exit 1
  printf '\n' >&2
  if [ "$password" != "$confirm" ]; then
    echo 'Passwords do not match; try again.' >&2
    unset password confirm
    continue
  fi
  break
done
install -d -m 0755 /etc/litefwm
umask 077
newfile=$(mktemp /etc/litefwm/.htpasswd.XXXXXX)
trap 'rm -f "$newfile"; if [ -n "${saved:-}" ]; then stty "$saved"; fi' EXIT HUP INT TERM
# htpasswd -i reads the password from stdin and -B hashes using bcrypt.
if ! printf '%s\n' "$password" | htpasswd -i -B -C 12 -c "$newfile" admin >/dev/null; then
  echo 'Password setup failed' >&2
  exit 1
fi
unset password confirm
chown root:lighttpd "$newfile"
chmod 0640 "$newfile"
mv -f "$newfile" /etc/litefwm/htpasswd
if [ -n "${saved:-}" ]; then stty "$saved"; fi
trap - EXIT HUP INT TERM
echo 'LiteFW2 web administrator password saved securely.'
