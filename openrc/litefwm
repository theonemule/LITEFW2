#!/sbin/openrc-run
name="LiteFWM"
description="Apply LiteFWM network, DHCP, NAT, and firewall configuration"

depend() {
  need localmount
  after networking
  before lighttpd
}

start() {
  ebegin "Applying LiteFWM policy"
  /usr/local/sbin/fwmctl apply
  eend $?
}

stop() {
  ebegin "Leaving current LiteFWM policy in place"
  eend 0
}
