#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi
require_root

bindir=$(dirname "$0")
cmd=$1

safe_module() {
  case "$1" in openvpn|tailscale|bind|squid|snort|haproxy) :;; *) die "Invalid module";; esac
}

case "$cmd" in
  status) "$bindir/fwmctl" status;;
  config-get) config_exists; cat "$LITEFWM_CONFIG";;
  config-set)
    ensure_dirs
    tmp=$(mktemp)
    cat > "$tmp"
    "$bindir/configctl" validate "$tmp" >/dev/null
    cp "$LITEFWM_CONFIG" "$LITEFWM_STATE/config.previous.json" 2>/dev/null || true
    install -m 0640 "$tmp" "$LITEFWM_CONFIG"
    rm -f "$tmp"
    jq -n '{ok:true}'
    ;;
  interfaces)
    ip -j addr show | jq '[.[] | {name:.ifname,state:.operstate,mtu:.mtu,mac:(.address // ""),addresses:[.addr_info[]? | {family:.family,address:.local,prefixlen:.prefixlen}]}]'
    ;;
  leases) "$bindir/dhcpctl" leases;;
  modules) "$bindir/modulectl" list;;
  metrics) "$bindir/metricsctl";;
  captures) "$bindir/capturectl" list;;
  diag-lookup)
    host=$2
    server=''
    [ "$#" -lt 3 ] || server=$3
    "$bindir/diagctl" lookup "$host" "$server" | jq -R -s '{output:.}'
    ;;
  diag-ping)
    host=$2
    "$bindir/diagctl" ping "$host" 3 | jq -R -s '{output:.}'
    ;;
  diag-route)
    host=$2
    "$bindir/diagctl" route "$host" | jq -R -s '{output:.}'
    ;;
  validate)
    out=$("$bindir/fwmctl" validate 2>&1)
    jq -n --arg message "$out" '{ok:true,message:$message}'
    ;;
  apply)
    out=$("$bindir/fwmctl" apply 2>&1)
    jq -n --arg message "$out" '{ok:true,message:$message}'
    ;;
  rollback)
    out=$("$bindir/fwmctl" rollback 2>&1)
    jq -n --arg message "$out" '{ok:true,message:$message}'
    ;;
  reserve)
    seg=$2
    mac=$3
    host=''
    [ "$#" -lt 4 ] || host=$4
    ip=$("$bindir/dhcpctl" reserve-lease "$seg" "$mac" "$host")
    jq -n --arg ip "$ip" '{ok:true,ip:$ip}'
    ;;
  module-install)
    mod=$2
    safe_module "$mod"
    out=$("$bindir/modulectl" install "$mod" 2>&1)
    jq -n --arg message "$out" '{ok:true,message:$message}'
    ;;
  module-remove)
    mod=$2
    safe_module "$mod"
    out=$("$bindir/modulectl" remove "$mod" 2>&1)
    jq -n --arg message "$out" '{ok:true,message:$message}'
    ;;
  capture-start)
    seg=$2
    seconds=$3
    out=$("$bindir/capturectl" start "$seg" "$seconds")
    jq -n --arg path "$out" '{ok:true,path:$path}'
    ;;
  capture-delete)
    name=$2
    "$bindir/capturectl" delete "$name"
    jq -n '{ok:true}'
    ;;
  logs)
    kind=$2
    count=$3
    "$bindir/logctl" "$kind" "$count" | jq -R -s '{lines:(split("\n") | map(select(length>0)))}'
    ;;
  *) die "Unsupported API operation";;
esac
