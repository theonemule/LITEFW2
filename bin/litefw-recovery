#!/bin/sh
# Local-console break-glass recovery for the LiteFW-owned nftables table.
# A bypass is VOLATILE; /etc/nftables.nft stays unchanged.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" = 0 ] || { echo "Local root console required"; exit 1; }
state=/run/litefwm/breakglass
pending=/run/litefwm/fw-pending
boot=/etc/nftables.nft

restore_table() {
  script=$(mktemp)
  echo 'destroy table inet litefw' >"$script"
  cat "$1" >>"$script"
  if ! nft -c -f "$script"; then rm -f "$script"; return 1; fi
  nft -f "$script" || { rm -f "$script"; return 1; }
  rm -f "$script"
}

case "$1" in
  status)
    if [ -s "$state/snapshot" ]; then echo enabled; exit 0; fi
    echo disabled; exit 1 ;;
  enable)
    [ ! -s "$state/snapshot" ] || { echo "Emergency bypass already active"; exit 0; }
    echo "WARNING: bypass temporarily allows ALL LiteFW incoming and forwarded traffic."
    echo "NAT is preserved. Use only from a trusted physical/Proxmox console."
    printf "Type YES to temporarily bypass firewall filtering: "
    IFS= read -r reply
    [ "$reply" = YES ] || { echo "Cancelled"; exit 1; }
    if [ -f "$pending/pending" ]; then
      echo 'Cancelling pending firewall edit before emergency recovery.'
      restore_table "$pending/before" || exit 1
      cp "$pending/boot" "$boot" || exit 1
      rm -f "$pending/pending" "$pending/before" "$pending/boot"
    fi
    install -d -m 0700 "$state"
    nft list table inet litefw >"$state/snapshot" ||
      { rm -rf "$state"; exit 1; }
    chmod 0600 "$state/snapshot"
    if ! nft insert rule inet litefw INPUT accept ||
       ! nft insert rule inet litefw FORWARD accept; then
      restore_table "$state/snapshot" || true
      rm -rf "$state"
      echo "Bypass failed; previous table restored" >&2
      exit 1
    fi
    echo "EMERGENCY FIREWALL BYPASS ENABLED until restored or rebooted." ;;
  disable)
    [ -s "$state/snapshot" ] ||
      { echo "Emergency bypass already OFF"; exit 0; }
    restore_table "$state/snapshot" || {
      echo "Unable to restore rules! Emergency bypass still active." >&2
      exit 1
    }
    rm -rf "$state"
    echo "Original firewall rules RESTORED immediately." ;;
  *)
    echo "Usage: litefw-recovery enable|disable|status" >&2; exit 2 ;;
esac