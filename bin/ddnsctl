#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

DDNS_DIR=$(printenv LITEFWM_DDNS_DIR 2>/dev/null || echo "$LITEFWM_ETC/modules/ddns")
DDNS_CONFIG=$(printenv LITEFWM_DDNS_CONFIG 2>/dev/null || echo "$DDNS_DIR/config.json")
DDCLIENT_CONFIG=$(printenv LITEFWM_DDCLIENT_CONFIG 2>/dev/null || echo /etc/ddclient/ddclient.conf)

default_config() {
  cat <<'JSON'
{
  "enabled": false,
  "provider": "cloudflare",
  "interval": 300,
  "source": "web",
  "interface": "",
  "zone": "",
  "server": "",
  "login": "",
  "password": "",
  "hostnames": []
}
JSON
}

init_config() {
  require_root
  mkdir -p "$DDNS_DIR"
  if [ ! -r "$DDNS_CONFIG" ]; then
    default_config > "$DDNS_CONFIG"
    chmod 0600 "$DDNS_CONFIG"
  fi
}

validate_file() {
  f=$1
  need jq
  jq -e '
    def text: type=="string" and (test("[\\r\\n]")|not);
    def hostname: type=="string" and length>0 and length<=253 and test("^[A-Za-z0-9_.-]+$");
    def ifname: type=="string" and (length==0 or test("^[A-Za-z0-9_.:-]{1,63}$"));
    (.enabled|type=="boolean") and
    (.provider=="cloudflare" or .provider=="noip" or .provider=="duckdns" or .provider=="namecheap" or .provider=="digitalocean" or .provider=="hetzner" or .provider=="dyndns2") and
    (.interval|type=="number" and .>=60 and .<=86400) and
    (.source=="web" or .source=="interface") and
    (.interface|ifname) and
    (.zone|text) and (.server|text) and (.login|text) and (.password|text) and
    (.hostnames|type=="array" and length>=1 and ([.[]|hostname]|all)) and
    (if .source=="interface" then (.interface|length)>0 else true end) and
    (if (.provider=="cloudflare" or .provider=="digitalocean" or .provider=="hetzner") then (.zone|length)>0 else true end) and
    (if .provider=="dyndns2" then ((.server|length)>0 and (.login|length)>0) else true end) and
    (if .provider=="noip" then (.login|length)>0 else true end) and
    (if .provider=="namecheap" then (.login|length)>0 else true end) and
    (.password|length)>0
  ' "$f" >/dev/null || die "Invalid Dynamic DNS configuration"
}

quote_value() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "\"%s\"", $0}'
}

render() {
  [ -r "$DDNS_CONFIG" ] || die "Dynamic DNS is not configured yet."
  validate_file "$DDNS_CONFIG"
  ensure_dirs
  out="$LITEFWM_GENERATED/ddclient.conf"

  enabled=$(jq -r .enabled "$DDNS_CONFIG")
  provider=$(jq -r .provider "$DDNS_CONFIG")
  interval=$(jq -r .interval "$DDNS_CONFIG")
  source=$(jq -r .source "$DDNS_CONFIG")
  interface=$(jq -r .interface "$DDNS_CONFIG")
  zone=$(jq -r .zone "$DDNS_CONFIG")
  server=$(jq -r .server "$DDNS_CONFIG")
  login=$(jq -r .login "$DDNS_CONFIG")
  password=$(jq -r .password "$DDNS_CONFIG")
  hosts=$(jq -r '.hostnames | join(",")' "$DDNS_CONFIG")

  {
    echo '# Generated by LiteFWM. Do not edit.'
    printf 'daemon=%s\n' "$interval"
    echo 'syslog=yes'
    echo 'ssl=yes'
    echo 'usev6=disabled'
    if [ "$source" = interface ]; then
      printf 'usev4=ifv4, ifv4=%s\n' "$interface"
    else
      echo 'usev4=webv4, webv4=ipify-ipv4'
    fi
    echo
    case "$provider" in
      cloudflare)
        echo 'protocol=cloudflare'
        printf 'zone=%s\n' "$(quote_value "$zone")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      noip)
        echo 'protocol=noip'
        echo 'server=dynupdate.no-ip.com'
        printf 'login=%s\n' "$(quote_value "$login")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      duckdns)
        echo 'protocol=duckdns'
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      namecheap)
        echo 'protocol=namecheap'
        echo 'server=dynamicdns.park-your-domain.com'
        printf 'login=%s\n' "$(quote_value "$login")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      digitalocean)
        echo 'protocol=digitalocean'
        printf 'zone=%s\n' "$(quote_value "$zone")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      hetzner)
        echo 'protocol=hetzner'
        printf 'zone=%s\n' "$(quote_value "$zone")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      dyndns2)
        echo 'protocol=dyndns2'
        printf 'server=%s\n' "$(quote_value "$server")"
        printf 'login=%s\n' "$(quote_value "$login")"
        printf 'password=%s\n' "$(quote_value "$password")"
        ;;
      *) die "Unsupported Dynamic DNS provider: $provider";;
    esac
    printf '%s\n' "$hosts"
  } > "$out"
  chmod 0600 "$out"
  echo "$out"
}

show_redacted() {
  if [ ! -r "$DDNS_CONFIG" ]; then
    default_config | jq '.password="" | .passwordSet=false'
    return
  fi
  jq '(.passwordSet = ((.password // "")|length > 0)) | .password = ""' "$DDNS_CONFIG"
}

set_config() {
  require_root
  src=$1
  mkdir -p "$DDNS_DIR"

  oldpass=''
  if [ -r "$DDNS_CONFIG" ]; then
    oldpass=$(jq -r '.password // ""' "$DDNS_CONFIG")
  fi
  newpass=$(jq -r '.password // ""' "$src")
  if [ -z "$newpass" ] && [ -n "$oldpass" ]; then
    tmp=$(mktemp)
    jq --arg p "$oldpass" '.password=$p | del(.passwordSet)' "$src" > "$tmp"
  else
    tmp=$(mktemp)
    jq 'del(.passwordSet)' "$src" > "$tmp"
  fi

  validate_file "$tmp"
  install -m 0600 "$tmp" "$DDNS_CONFIG"
  rm -f "$tmp"
  jq -n '{ok:true}'
}

status_json() {
  installed=false
  running=false
  configured=false
  enabled=false
  command -v ddclient >/dev/null 2>&1 && installed=true
  [ -r "$DDNS_CONFIG" ] && configured=true
  if [ "$configured" = true ]; then
    enabled=$(jq -r '.enabled // false' "$DDNS_CONFIG")
  fi
  rc-service ddclient status >/dev/null 2>&1 && running=true
  jq -n     --argjson installed "$installed"     --argjson configured "$configured"     --argjson enabled "$enabled"     --argjson running "$running"     '{installed:$installed,configured:$configured,enabled:$enabled,running:$running}'
}

apply_config() {
  require_root
  command -v ddclient >/dev/null 2>&1 || die "ddclient is not installed. Install the Dynamic DNS module first."
  [ -r "$DDNS_CONFIG" ] || die "Dynamic DNS is not configured yet."
  validate_file "$DDNS_CONFIG"
  enabled=$(jq -r .enabled "$DDNS_CONFIG")

  if [ "$enabled" != true ]; then
    rc-service ddclient stop >/dev/null 2>&1 || true
    rc-update del ddclient default >/dev/null 2>&1 || true
    jq -n '{ok:true,running:false,message:"Dynamic DNS saved but disabled."}'
    return
  fi

  f=$(render)
  mkdir -p "$(dirname "$DDCLIENT_CONFIG")"
  install -m 0600 "$f" "$DDCLIENT_CONFIG"
  rc-update add ddclient default >/dev/null
  if rc-service ddclient status >/dev/null 2>&1; then
    rc-service ddclient restart >/dev/null
  else
    rc-service ddclient start >/dev/null
  fi
  jq -n '{ok:true,running:true,message:"Dynamic DNS configuration applied."}'
}

query_ip() {
  require_root
  command -v ddclient >/dev/null 2>&1 || die "ddclient is not installed."
  [ -r "$DDNS_CONFIG" ] || die "Dynamic DNS is not configured yet."
  f=$(render)
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT INT TERM
  cp "$f" "$tmp/ddclient.conf"
  timeout 20 ddclient --file "$tmp/ddclient.conf" --daemon=0 --query 2>&1 | tail -n 80 | jq -R -s '{output:.}'
}

cmd=$1
case "$cmd" in
  init) init_config;;
  validate)
    f=$DDNS_CONFIG
    [ "$#" -lt 2 ] || f=$2
    validate_file "$f"
    echo "Dynamic DNS configuration valid."
    ;;
  show) show_redacted;;
  set)
    src=$2
    set_config "$src"
    ;;
  render) render;;
  apply) apply_config;;
  status) status_json;;
  query) query_ip;;
  *) echo "Usage: ddnsctl init|validate [FILE]|show|set FILE|render|apply|status|query" >&2; exit 2;;
esac
