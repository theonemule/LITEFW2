#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

case "${1:-}" in
  query)
    if command -v ddclient >/dev/null 2>&1 && [ -s /etc/ddclient/ddclient.conf ]; then
      timeout 20 ddclient --file /etc/ddclient/ddclient.conf --daemon=0 --query 2>&1 | tail -n 80 | jq -R -s '{output:.}'
    else
      dev=$(ip -4 route show default 2>/dev/null | awk 'NR==1{print $5}')
      ip4=''
      [ -z "$dev" ] || ip4=$(ip -4 -o addr show dev "$dev" scope global | awk 'NR==1{sub(/\/.*/,"",$4);print $4}')
      jq -n --arg output "Default interface: $dev\nIPv4: $ip4\n" '{output:$output}'
    fi
    ;;
  *)
    echo "Usage: ddnsctl query" >&2
    exit 2;;
esac
