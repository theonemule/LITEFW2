#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

case "$1" in
  list)
    mkdir -p "$LITEFWM_CAPTURE_DIR"
    first=true
    printf '['
    for f in "$LITEFWM_CAPTURE_DIR"/*.pcap; do
      [ -f "$f" ] || continue
      name=$(basename "$f")
      bytes=$(stat -c %s "$f" 2>/dev/null || echo 0)
      mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
      [ "$first" = true ] || printf ','
      first=false
      jq -cn --arg name "$name" --argjson bytes "$bytes" --argjson mtime "$mtime" '{name:$name,bytes:$bytes,mtime:$mtime}'
    done
    printf ']\n'
    ;;
  start)
    require_root
    seg=$2
    seconds=30
    [ "$#" -lt 3 ] || seconds=$3
    case "$seconds" in *[!0-9]*|'') die "Capture duration must be seconds";; esac
    [ "$seconds" -le 300 ] || die "Maximum capture duration is 300 seconds."
    dev=$("$SELF_DIR/netctl" segments | jq -r --arg s "$seg" '[.[]|select(.id==$s)|.interface][0] // $s')
    ip link show dev "$dev" >/dev/null 2>&1 || die "Unknown live segment/interface: $seg"
    mkdir -p "$LITEFWM_CAPTURE_DIR"
    out="$LITEFWM_CAPTURE_DIR/$seg-$(date +%Y%m%d-%H%M%S).pcap"
    timeout "$seconds" tcpdump -i "$dev" -s 0 -w "$out" >/dev/null 2>&1 || true
    echo "$out"
    ;;
  delete)
    require_root
    name=$2
    case "$name" in */*|..*|'') die "Invalid capture name";; esac
    rm -f "$LITEFWM_CAPTURE_DIR/$name"
    ;;
  *) echo "Usage: capturectl list|start SEGMENT [SECONDS]|delete NAME" >&2; exit 2;;
esac
