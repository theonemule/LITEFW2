#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi
bindir=$(dirname "$0")

status_json() {
  host=$(hostname)
  interfaces=$("$bindir/netctl" interfaces | jq 'length')
  segments=$("$bindir/netctl" segments | jq 'length')
  rules=$("$bindir/firewallctl" snapshot 2>/dev/null | jq '.rules|length' 2>/dev/null || echo 0)
  leases=$("$bindir/dhcpctl" leases 2>/dev/null | jq 'length' 2>/dev/null || echo 0)
  jq -n --arg host "$host" --argjson interfaces "$interfaces" --argjson segments "$segments"     --argjson rules "$rules" --argjson leases "$leases"     '{hostname:$host,state:"live",lastApply:"live",interfaces:$interfaces,segments:$segments,rules:$rules,leases:$leases}'
}
validate_live() {
  ip -j link show >/dev/null
  ip -4 -j addr show >/dev/null
  if command -v lighttpd >/dev/null 2>&1; then lighttpd -tt -f /etc/lighttpd/lighttpd.conf >/dev/null; fi
  if [ -s "$LITEFWM_DNSMASQ_CONF" ] && command -v dnsmasq >/dev/null 2>&1; then
    dnsmasq --test --conf-file="$LITEFWM_DNSMASQ_CONF" >/dev/null
  fi
  if command -v iptables-save >/dev/null 2>&1 && command -v iptables-restore >/dev/null 2>&1; then
    iptables-save | iptables-restore --test
  fi
  echo "Live Linux and service configuration is valid."
}
case "${1:-}" in
  status) status_json;;
  validate) validate_live;;
  show) "$bindir/configctl" show;;
  *) echo "Usage: fwmctl status|validate|show" >&2; exit 2;;
esac
