#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

snapshot() {
  [ -r "$LITEFWM_DNSMASQ_CONF" ] || { echo '[]'; return; }
  awk '
    function emit() {
      if (iface=="") return
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",iface,start,end,lease,router,dns,ntp,domain
    }
    /^# litefwm-interface / {
      emit()
      iface=$3; start=""; end=""; lease="12h"; router=""; dns=""; ntp=""; domain=""
      next
    }
    /^dhcp-range=set:/ {
      x=$0; sub(/^dhcp-range=set:[^,]+,/,"",x); n=split(x,a,",")
      start=a[1]; end=a[2]; if(n>=3) lease=a[3]
      next
    }
    /option:router,/ {x=$0; sub(/^.*option:router,/,"",x); router=x; next}
    /option:dns-server,/ {x=$0; sub(/^.*option:dns-server,/,"",x); dns=x; next}
    /option:ntp-server,/ {x=$0; sub(/^.*option:ntp-server,/,"",x); ntp=x; next}
    /option:domain-name,/ {x=$0; sub(/^.*option:domain-name,/,"",x); domain=x; next}
    END{emit()}
  ' "$LITEFWM_DNSMASQ_CONF" |
  while IFS="$(printf '\t')" read -r iface start end lease router dns ntp domain; do
    reservations=$(awk -v tag="$iface" '
      $0=="# litefwm-reservations "tag {on=1;next}
      /^# litefwm-/ && on {exit}
      on && /^dhcp-host=/ {
        x=$0; sub(/^dhcp-host=/,"",x); n=split(x,a,",")
        if(n>=2) printf "%s\t%s\t%s\n",a[1],a[2],(n>=3?a[3]:"")
      }
    ' "$LITEFWM_DNSMASQ_CONF" |
    while IFS="$(printf '\t')" read -r mac ip host; do
      jq -n --arg mac "$mac" --arg ip "$ip" --arg host "$host" \
        '{mac:$mac,ip:$ip} + (if $host=="" then {} else {hostname:$host} end)'
    done | jq -s .)
    dnsj=$(printf '%s' "$dns"|tr ',' '\n'|jq -R -s 'split("\n")|map(select(length>0))')
    ntpj=$(printf '%s' "$ntp"|tr ',' '\n'|jq -R -s 'split("\n")|map(select(length>0))')
    jq -n --arg interface "$iface" --arg start "$start" --arg end "$end" --arg lease "$lease" \
      --arg gateway "$router" --arg domain "$domain" --argjson dns "$dnsj" --argjson ntp "$ntpj" \
      --argjson reservations "$reservations" \
      '{interface:$interface,enabled:true,poolStart:$start,poolEnd:$end,leaseTime:$lease,
        gateway:$gateway,dns:$dns,ntp:$ntp,domain:$domain,reservations:$reservations}'
  done | jq -s .
}

render() {
  file=$1
  {
    echo '# Native dnsmasq configuration managed live by LiteFWM.'
    echo 'bind-dynamic'
    echo 'domain-needed'
    echo 'bogus-priv'
    echo 'dhcp-authoritative'
    echo "dhcp-leasefile=$LITEFWM_LEASES"
    jq -c '.segments[] | select(.dhcp.enabled==true)' "$file" |
    while IFS= read -r seg; do
      iface=$(printf '%s' "$seg"|jq -r .interface)
      tag=$(printf '%s' "$seg"|jq -r .id | tr -c 'A-Za-z0-9_.-' '-')
      start=$(printf '%s' "$seg"|jq -r .dhcp.poolStart)
      end=$(printf '%s' "$seg"|jq -r .dhcp.poolEnd)
      lease=$(printf '%s' "$seg"|jq -r '.dhcp.leaseTime // "12h"')
      gateway=$(printf '%s' "$seg"|jq -r '.dhcp.gateway // empty')
      if [ -z "$gateway" ]; then
        gateway=$(printf '%s' "$seg"|jq -r 'if .addressMode=="static" then (.address|split("/")[0]) else (.currentAddress|split("/")[0]) end')
      fi
      dns=$(printf '%s' "$seg"|jq -r 'if ((.dhcp.dns//[])|length)>0 then (.dhcp.dns|join(",")) else (.dns|join(",")) end')
      ntp=$(printf '%s' "$seg"|jq -r '(.dhcp.ntp // [])|join(",")')
      domain=$(printf '%s' "$seg"|jq -r '.domain // empty')
      echo
      echo "# litefwm-interface $iface"
      echo "interface=$iface"
      echo "dhcp-range=set:$tag,$start,$end,$lease"
      [ -z "$gateway" ] || echo "dhcp-option=tag:$tag,option:router,$gateway"
      [ -z "$dns" ] || echo "dhcp-option=tag:$tag,option:dns-server,$dns"
      [ -z "$ntp" ] || echo "dhcp-option=tag:$tag,option:ntp-server,$ntp"
      [ -z "$domain" ] || echo "dhcp-option=tag:$tag,option:domain-name,$domain"
      echo "# litefwm-reservations $iface"
      printf '%s' "$seg"|jq -c '.dhcp.reservations[]?' |
      while IFS= read -r r; do
        mac=$(printf '%s' "$r"|jq -r .mac); ip=$(printf '%s' "$r"|jq -r .ip); host=$(printf '%s' "$r"|jq -r '.hostname // empty')
        if [ -n "$host" ]; then echo "dhcp-host=$mac,$ip,$host"; else echo "dhcp-host=$mac,$ip"; fi
      done
    done
  }
}

reconcile() {
  require_root; file=$1
  tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT INT TERM
  render "$file" > "$tmp"
  count=$(jq '[.segments[]|select(.dhcp.enabled==true)]|length' "$file")
  mkdir -p "$(dirname "$LITEFWM_DNSMASQ_CONF")" "$(dirname "$LITEFWM_LEASES")"
  if [ "$count" -eq 0 ]; then
    install -m 0644 "$tmp" "$LITEFWM_DNSMASQ_CONF"
    rc-service dnsmasq stop >/dev/null 2>&1 || true
    rc-update del dnsmasq default >/dev/null 2>&1 || true
    return
  fi
  need dnsmasq
  dnsmasq --test --conf-file="$tmp" >/dev/null
  install -m 0644 "$tmp" "$LITEFWM_DNSMASQ_CONF"
  rc-update add dnsmasq default >/dev/null 2>&1 || true
  if rc-service dnsmasq status >/dev/null 2>&1; then rc-service dnsmasq restart >/dev/null
  else rc-service dnsmasq start >/dev/null
  fi
}

ip_to_int() { awk -F. '{print (((($1*256)+$2)*256+$3)*256+$4)}' <<EOF
$1
EOF
}

leases() {
  [ -r "$LITEFWM_LEASES" ] || { echo '[]'; return; }
  pools=$(snapshot)
  awk '{printf "%s\t%s\t%s\t%s\t%s\n",$1,$2,$3,$4,$5}' "$LITEFWM_LEASES" |
  while IFS="$(printf '\t')" read -r expires mac ip host client; do
    ipn=$(ip_to_int "$ip")
    iface=$(printf '%s' "$pools"|jq -r --argjson ipn "$ipn" '
      def ipn: split(".")|map(tonumber)|(((.[0]*256+.[1])*256+.[2])*256+.[3]);
      [.[]|select($ipn >= (.poolStart|ipn) and $ipn <= (.poolEnd|ipn))|.interface][0] // ""')
    jq -n --argjson expires "$expires" --arg mac "$mac" --arg ip "$ip" --arg hostname "$host" --arg clientId "$client" --arg segment "$iface" \
      '{expires:$expires,mac:$mac,ip:$ip,hostname:$hostname,clientId:$clientId,segment:$segment}'
  done | jq -s .
}

reserve_lease() {
  require_root
  segment=$1; mac=$2; host=$3
  [ -r "$LITEFWM_LEASES" ] || die "No DHCP lease database yet."
  ip=$(awk -v m="$(printf '%s' "$mac"|tr '[:upper:]' '[:lower:]')" 'tolower($2)==m {print $3;exit}' "$LITEFWM_LEASES")
  [ -n "$ip" ] || die "No active lease found for $mac"
  iface=$segment
  netseg=$("$SELF_DIR/netctl" segments)
  mapped=$(printf '%s' "$netseg"|jq -r --arg s "$segment" '[.[]|select(.id==$s)|.interface][0] // empty')
  [ -z "$mapped" ] || iface=$mapped
  [ -r "$LITEFWM_DNSMASQ_CONF" ] || die "DHCP server is not configured."
  tmp=$(mktemp)
  awk -v iface="$iface" -v mac="$mac" '
    BEGIN{skip=0}
    $0=="# litefwm-reservations "iface {print; inres=1; next}
    /^# litefwm-/ && inres {inres=0}
    inres && $0 ~ "^dhcp-host="mac"," {next}
    {print}
  ' "$LITEFWM_DNSMASQ_CONF" > "$tmp"
  line="dhcp-host=$mac,$ip"; [ -z "$host" ] || line="$line,$host"
  awk -v iface="$iface" -v line="$line" '
    {print}
    $0=="# litefwm-reservations "iface {print line; inserted=1}
    END{if(!inserted){print "# litefwm-reservations "iface; print line}}
  ' "$tmp" > "$tmp.2"
  install -m 0644 "$tmp.2" "$LITEFWM_DNSMASQ_CONF"
  rm -f "$tmp" "$tmp.2"
  dnsmasq --test --conf-file="$LITEFWM_DNSMASQ_CONF" >/dev/null
  rc-service dnsmasq restart >/dev/null
  jq -n --arg ip "$ip" --arg segment "$iface" '{ip:$ip,segment:$segment}'
}

case "${1:-}" in
  snapshot) snapshot;;
  render) render "${2:?live snapshot file}";;
  reconcile) reconcile "${2:?live snapshot file}";;
  leases) leases;;
  reserve-lease) reserve_lease "${2:-}" "${3:?MAC required}" "${4:-}";;
  *) echo "Usage: dhcpctl snapshot|render FILE|reconcile FILE|leases|reserve-lease [SEGMENT] MAC [HOSTNAME]" >&2; exit 2;;
esac
