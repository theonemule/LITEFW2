#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

render() {
  config_exists
  ensure_dirs
  need jq
  out="$LITEFWM_GENERATED/dnsmasq.conf"

  {
    echo '# Generated by LiteFWM. Do not edit.'
    echo 'bind-dynamic'
    echo 'domain-needed'
    echo 'bogus-priv'
    echo 'dhcp-authoritative'
    echo "dhcp-leasefile=$LITEFWM_STATE/dnsmasq.leases"

    jq -c '.segments[] | select(.dhcp.enabled == true)' "$LITEFWM_CONFIG" |
    while IFS= read -r seg; do
      id=$(printf '%s' "$seg" | jq -r .id)
      dev=$(segment_device "$id")
      start=$(printf '%s' "$seg" | jq -r .dhcp.poolStart)
      end=$(printf '%s' "$seg" | jq -r .dhcp.poolEnd)
      lease=$(printf '%s' "$seg" | jq -r '.dhcp.leaseTime // "12h"')
      gateway=$(printf '%s' "$seg" | jq -r '.dhcp.gateway // empty')
      dns=$(printf '%s' "$seg" | jq -r '.dhcp.dns // [] | join(",")')

      printf 'interface=%s\n' "$dev"
      printf 'dhcp-range=set:%s,%s,%s,%s\n' "$id" "$start" "$end" "$lease"
      [ -z "$gateway" ] || printf 'dhcp-option=tag:%s,option:router,%s\n' "$id" "$gateway"
      [ -z "$dns" ] || printf 'dhcp-option=tag:%s,option:dns-server,%s\n' "$id" "$dns"

      printf '%s' "$seg" | jq -c '.dhcp.reservations[]?' |
      while IFS= read -r reservation; do
        mac=$(printf '%s' "$reservation" | jq -r .mac)
        ip=$(printf '%s' "$reservation" | jq -r .ip)
        host=$(printf '%s' "$reservation" | jq -r '.hostname // empty')
        if [ -n "$host" ]; then
          printf 'dhcp-host=%s,%s,%s\n' "$mac" "$ip" "$host"
        else
          printf 'dhcp-host=%s,%s\n' "$mac" "$ip"
        fi
      done
    done
  } > "$out"

  echo "$out"
}

leases() {
  leasefile="$LITEFWM_STATE/dnsmasq.leases"
  if [ ! -r "$leasefile" ]; then
    echo '[]'
    return
  fi
  awk '{
    printf "{\"expires\":%s,\"mac\":\"%s\",\"ip\":\"%s\",\"hostname\":\"%s\",\"clientId\":\"%s\"}\n",$1,$2,$3,$4,$5
  }' "$leasefile" | jq -s .
}

reserve_lease() {
  require_root
  seg=$1
  mac=$2
  host=$3
  leasefile="$LITEFWM_STATE/dnsmasq.leases"
  [ -r "$leasefile" ] || die "No DHCP lease database yet."

  ip=$(awk -v m="$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]')" 'tolower($2)==m {print $3; exit}' "$leasefile")
  [ -n "$ip" ] || die "No active lease found for $mac"

  tmp=$(mktemp)
  jq --arg s "$seg" --arg mac "$mac" --arg ip "$ip" --arg host "$host" '
    .segments |= map(
      if .id==$s then
        .dhcp.reservations = (
          (.dhcp.reservations // [])
          | map(select((.mac|ascii_downcase) != ($mac|ascii_downcase)))
          + [({mac:$mac,ip:$ip} + (if ($host|length)>0 then {hostname:$host} else {} end))]
        )
      else . end
    )
  ' "$LITEFWM_CONFIG" > "$tmp"

  "$(dirname "$0")/configctl" validate "$tmp" >/dev/null
  cp "$LITEFWM_CONFIG" "$LITEFWM_STATE/config.previous.json"
  mv "$tmp" "$LITEFWM_CONFIG"
  echo "$ip"
}

cmd=$1
case "$cmd" in
  render) render;;
  check)
    need dnsmasq
    f=$(render)
    dnsmasq --test --conf-file="$f"
    ;;
  apply)
    require_root
    need dnsmasq
    enabled=$(jq '[.segments[] | select(.dhcp.enabled == true)] | length' "$LITEFWM_CONFIG")
    if [ "$enabled" -eq 0 ]; then
      rc-service dnsmasq stop >/dev/null 2>&1 || true
      render >/dev/null
      exit 0
    fi
    f=$(render)
    dnsmasq --test --conf-file="$f" >/dev/null
    if rc-service dnsmasq status >/dev/null 2>&1; then
      rc-service dnsmasq restart
    else
      rc-service dnsmasq start
    fi
    ;;
  leases) leases;;
  reserve-lease)
    seg=$2
    mac=$3
    host=''
    [ "$#" -lt 4 ] || host=$4
    reserve_lease "$seg" "$mac" "$host"
    ;;
  *) echo "Usage: dhcpctl render|check|apply|leases|reserve-lease SEGMENT MAC [HOSTNAME]" >&2; exit 2;;
esac
