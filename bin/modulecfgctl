#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

safe_module() { case "$1" in openvpn|tailscale|bind|squid|snort|haproxy|ddns) :;; *) die "Invalid module";; esac; }
service_for() { case "$1" in bind) echo named;; ddns) echo ddclient;; *) echo "$1";; esac; }
path_for() {
  case "$1" in
    openvpn) echo /etc/openvpn/openvpn.conf;;
    tailscale) echo /etc/conf.d/tailscale;;
    bind) echo /etc/bind/named.conf;;
    squid) echo /etc/squid/squid.conf;;
    snort) [ -e /etc/snort/snort.lua ] && echo /etc/snort/snort.lua || echo /etc/snort/snort.conf;;
    haproxy) echo /etc/haproxy/haproxy.cfg;;
    ddns) echo /etc/ddclient/ddclient.conf;;
  esac
}
default_text() {
  case "$1" in
    openvpn) printf '# OpenVPN native configuration\n';;
    tailscale) printf '# Tailscale OpenRC configuration\n';;
    bind) printf '# BIND native configuration\n';;
    squid) printf '# Squid native configuration\n';;
    snort) printf '# Snort native configuration\n';;
    haproxy) printf '# HAProxy native configuration\n';;
    ddns) printf '# ddclient native configuration\n';;
  esac
}
show_cfg() {
  mod=$1; safe_module "$mod"; path=$(path_for "$mod")
  raw=''; [ -r "$path" ] && raw=$(cat "$path")
  svc=$(service_for "$mod")
  enabled=false; rc-update show default 2>/dev/null | awk '{print $1}' | grep -Fxq "$svc" && enabled=true
  jq -n --arg raw "$raw" --arg path "$path" --argjson enabled "$enabled" '{raw:$raw,path:$path,enabled:$enabled}'
}
status_cfg() {
  mod=$1; safe_module "$mod"; path=$(path_for "$mod"); svc=$(service_for "$mod")
  configured=false; [ -s "$path" ] && configured=true
  running=false; rc-service "$svc" status >/dev/null 2>&1 && running=true
  enabled=false; rc-update show default 2>/dev/null | awk '{print $1}' | grep -Fxq "$svc" && enabled=true
  jq -n --arg path "$path" --argjson configured "$configured" --argjson running "$running" --argjson enabled "$enabled"     '{configured:$configured,running:$running,enabled:$enabled,path:$path}'
}
init_cfg() {
  require_root; mod=$1; safe_module "$mod"; path=$(path_for "$mod")
  [ -e "$path" ] && return 0
  mkdir -p "$(dirname "$path")"
  default_text "$mod" > "$path"
  chmod 0600 "$path"
}
set_cfg() {
  require_root; mod=$1; src=$2; safe_module "$mod"; path=$(path_for "$mod")
  raw=$(jq -r '.raw // ""' "$src")
  enabled=$(jq -r 'if .enabled==null then false else .enabled end' "$src")
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$raw" > "$path"
  chmod 0600 "$path"
  svc=$(service_for "$mod")
  if [ "$enabled" = true ]; then rc-update add "$svc" default >/dev/null 2>&1 || true
  else rc-update del "$svc" default >/dev/null 2>&1 || true
  fi
  apply_cfg "$mod"
}
apply_cfg() {
  require_root; mod=$1; safe_module "$mod"; svc=$(service_for "$mod")
  enabled=false; rc-update show default 2>/dev/null | awk '{print $1}' | grep -Fxq "$svc" && enabled=true
  if [ "$enabled" = true ]; then
    if rc-service "$svc" status >/dev/null 2>&1; then rc-service "$svc" restart >/dev/null
    else rc-service "$svc" start >/dev/null
    fi
    echo "$mod native configuration applied."
  else
    rc-service "$svc" stop >/dev/null 2>&1 || true
    echo "$mod disabled."
  fi
}
case "${1:-}" in
  init) init_cfg "${2:?MODULE}";;
  show) show_cfg "${2:?MODULE}";;
  status) status_cfg "${2:?MODULE}";;
  set) set_cfg "${2:?MODULE}" "${3:?JSON FILE}";;
  apply) apply_cfg "${2:?MODULE}";;
  validate-installed) echo "Native module configuration is live.";;
  bind-reserve) die "DNS reservation publishing requires native BIND zone editing and is not available in raw native-config mode.";;
  *) echo "Usage: modulecfgctl init|show|status|set|apply MODULE [FILE]" >&2; exit 2;;
esac
