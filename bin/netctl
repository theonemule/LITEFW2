#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

iface_mode() {
  dev=$1
  awk -v d="$dev" '
    $1=="iface" && $2==d && $3=="inet" {print $4; found=1; exit}
    END{if(!found) print "none"}
  ' "$LITEFWM_INTERFACES" 2>/dev/null
}

inventory() {
  need ip; need jq
  links=$(ip -d -j link show)
  addrs=$(ip -4 -j addr show)
  routes=$(ip -4 -j route show table main 2>/dev/null || printf '[]')
  dns=$(awk '/^nameserver[[:space:]]+/ {print $2}' /etc/resolv.conf 2>/dev/null | jq -R -s 'split("\n") | map(select(length>0))')
  configured=$(awk '$1=="iface" && $3=="inet" {print $2}' "$LITEFWM_INTERFACES" 2>/dev/null | jq -R -s 'split("\n") | map(select(length>0))')
  dhcp=$(awk '$1=="iface" && $3=="inet" && $4=="dhcp" {print $2}' "$LITEFWM_INTERFACES" 2>/dev/null | jq -R -s 'split("\n") | map(select(length>0))')

  jq -n \
    --argjson links "$links" \
    --argjson addrs "$addrs" \
    --argjson routes "$routes" \
    --argjson dns "$dns" \
    --argjson configured "$configured" \
    --argjson dhcp "$dhcp" '
    [
      $links[] as $l |
      ($l.linkinfo.info_kind // "") as $kind |
      ($l.ifname!="lo" and $kind=="" and ($l.link_type // "")=="ether") as $physical |
      ([ $addrs[]? | select(.ifname==$l.ifname) | .addr_info[]? |
          select(.family=="inet" and .scope=="global") |
          {address:.local,prefixlen:.prefixlen,cidr:(.local+"/"+(.prefixlen|tostring)),dynamic:(.dynamic // false)}
       ]) as $ipv4 |
      ([ $routes[]? | select(.dev==$l.ifname and ((.dst // "")=="default")) ][0] // null) as $def |
      ([ $links[]? | select((.master // "")==$l.ifname) | .ifname ]) as $members |
      (if $kind=="vlan" then ([ $links[]? | select(.ifindex==($l.link_index // -1)) | .ifname ][0] // "") else "" end) as $parent |
      ([$ipv4[]? | select(.dynamic==true)] | length) as $dynamic_count |
      {
        id:$l.ifname,
        name:$l.ifname,
        device:$l.ifname,
        ifindex:$l.ifindex,
        state:($l.operstate // "UNKNOWN"),
        enabled:(($l.flags // []) | index("UP") != null),
        mtu:$l.mtu,
        mac:($l.address // ""),
        kind:(if $l.ifname=="lo" then "loopback"
              elif $kind!="" then $kind
              elif $physical then "physical"
              else ($l.link_type // "virtual") end),
        type:(if $l.ifname=="lo" then "loopback"
              elif $kind=="bridge" then "bridge"
              elif $kind=="vlan" then "vlan"
              elif $physical then "physical"
              elif $kind!="" then $kind
              else "virtual" end),
        physical:$physical,
        persistent:(($configured|index($l.ifname))!=null),
        managed:((($configured|index($l.ifname))!=null) or $physical),
        "master":($l.master // null),
        "members":$members,
        "parent":$parent,
        vlanId:($l.linkinfo.info_data.id // null),
        vlanAware:($l.linkinfo.info_data.vlan_filtering // false),
        ipv4:$ipv4,
        addressMode:(if (($dhcp|index($l.ifname))!=null or $dynamic_count>0) then "dhcp"
                     elif ($ipv4|length)>0 then "static"
                     else "none" end),
        defaultGateway:(if $def==null then "" else ($def.gateway // "") end),
        defaultRoute:($def!=null),
        dns:$dns
      }
    ]'
}

interfaces_model() { inventory | jq '[.[] | select(.name!="lo")]'; }

segments() {
  inventory | jq '
    [
      .[] | select(.name!="lo") as $i |
      ($i.ipv4 // []) as $ips |
      if (($i.addressMode=="dhcp") and (($ips|length)==0)) then
        {id:$i.name,name:$i.name,interface:$i.name,
         zone:(if $i.defaultRoute then "external" else "internal" end),
         addressMode:"dhcp",address:"",currentAddress:"",gateway:$i.defaultGateway,
         dns:$i.dns,domain:"",dhcpClient:{hostname:""},
         dhcp:{enabled:false,dns:[],ntp:[],reservations:[]},managed:$i.managed}
      else
        ($ips | to_entries[] |
          .key as $n | .value as $a |
          {id:(if $n==0 then $i.name else ($i.name+"-"+(($n+1)|tostring)) end),
           name:(if $n==0 then $i.name else ($i.name+" address "+(($n+1)|tostring)) end),
           interface:$i.name,
           zone:(if $i.defaultRoute then "external" else "internal" end),
           addressMode:(if ($n==0 and $i.addressMode=="dhcp") then "dhcp" else "static" end),
           address:(if ($n==0 and $i.addressMode=="dhcp") then "" else $a.cidr end),
           currentAddress:$a.cidr,
           gateway:(if $i.defaultRoute then $i.defaultGateway else "" end),
           dns:$i.dns,domain:"",dhcpClient:{hostname:""},
           dhcp:{enabled:false,dns:[],ntp:[],reservations:[]},managed:$i.managed})
      end
    ]'
}

device_for_id() {
  file=$1; id=$2
  jq -er --arg id "$id" '.interfaces[] | select(.id==$id) | .device' "$file"
}

normalize_desired() {
  src=$1; dst=$2
  jq '
    reduce (.interfaces[] | select(.type=="bridge") | {bridge:.id,members:(.members // [])}) as $b
      (.;
       reduce $b.members[] as $m (.;
         .segments |= map(if .interface==$m then .interface=$b.bridge else . end)
       )
      )
  ' "$src" > "$dst"
}

run_ip() {
  if [ "${LITEFWM_DRY_RUN:-0}" = 1 ]; then
    printf '+ ip'; printf ' %s' "$@"; printf '\n'
  else
    ip "$@"
  fi
}

bridge_create_or_update() {
  file=$1; obj=$2
  dev=$(printf '%s' "$obj"|jq -r .device)
  mtu=$(printf '%s' "$obj"|jq -r '.mtu // 1500')
  aware=$(printf '%s' "$obj"|jq -r 'if .vlanAware==null then false else .vlanAware end')
  if ! ip link show dev "$dev" >/dev/null 2>&1; then
    run_ip link add name "$dev" type bridge
    first_member=$(printf '%s' "$obj"|jq -r '.members[0] // empty')
    if [ -n "$first_member" ]; then
      member=$(device_for_id "$file" "$first_member")
      mac=$(ip -j link show dev "$member" 2>/dev/null | jq -r '.[0].address // empty')
      [ -z "$mac" ] || run_ip link set dev "$dev" address "$mac"
    fi
  fi
  run_ip link set dev "$dev" mtu "$mtu"
  filtering=0; [ "$aware" = true ] && filtering=1
  run_ip link set dev "$dev" type bridge vlan_filtering "$filtering"
  run_ip link set dev "$dev" up
}

vlan_create_or_update() {
  file=$1; obj=$2
  dev=$(printf '%s' "$obj"|jq -r .device)
  parent_id=$(printf '%s' "$obj"|jq -r .parent)
  parent=$(device_for_id "$file" "$parent_id")
  vid=$(printf '%s' "$obj"|jq -r .vlanId)
  mtu=$(printf '%s' "$obj"|jq -r '.mtu // 1500')
  if ! ip link show dev "$dev" >/dev/null 2>&1; then
    run_ip link add link "$parent" name "$dev" type vlan id "$vid"
  fi
  run_ip link set dev "$dev" mtu "$mtu"
  run_ip link set dev "$dev" up
}

stop_udhcpc_for_device() {
  dev=$1
  if [ "$(printenv LITEFWM_DRY_RUN 2>/dev/null || echo 0)" = 1 ]; then
    printf '+ stop udhcpc on %s
' "$dev"
    return 0
  fi
  for pidfile in "/run/udhcpc.$dev.pid" "/run/udhcpc-$dev.pid" "/var/run/udhcpc.$dev.pid" "/var/run/udhcpc-$dev.pid"; do
    [ -r "$pidfile" ] || continue
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [ -z "$pid" ] || kill "$pid" >/dev/null 2>&1 || true
    rm -f "$pidfile"
  done
  if command -v pkill >/dev/null 2>&1; then
    pkill -f "udhcpc.*-i[[:space:]]+$dev([[:space:]]|$)" >/dev/null 2>&1 || true
  else
    ps ww 2>/dev/null | awk -v d="$dev" '$0 ~ /[u]dhcpc/ && $0 ~ ("-i " d "($| )") {print $1}' |
    while IFS= read -r pid; do kill "$pid" >/dev/null 2>&1 || true; done
  fi
}

udhcpc_running_for_device() {
  dev=$1
  for pidfile in "/run/udhcpc.$dev.pid" "/run/udhcpc-$dev.pid" "/var/run/udhcpc.$dev.pid" "/var/run/udhcpc-$dev.pid"; do
    [ -r "$pidfile" ] || continue
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1 && return 0
  done
  ps ww 2>/dev/null | grep -E "[u]dhcpc.*-i[[:space:]]+$dev([[:space:]]|$)" >/dev/null 2>&1
}

start_udhcpc_for_device() {
  dev=$1
  request=${2:-}
  if [ "${LITEFWM_DRY_RUN:-0}" = 1 ]; then
    printf '+ udhcpc -i %s -b -q' "$dev"
    [ -z "$request" ] || printf ' -r %s' "$request"
    printf '\n'
    return 0
  fi
  command -v udhcpc >/dev/null 2>&1 || return 0
  if [ -n "$request" ]; then
    udhcpc -i "$dev" -b -q -n -t 8 -T 2 -r "$request" >/dev/null 2>&1 || true
  else
    udhcpc -i "$dev" -b -q -n -t 8 -T 2 >/dev/null 2>&1 || true
  fi
}
move_member_l3_to_bridge() {
  member=$1
  bridge=$2
  [ "$member" = "$bridge" ] && return 0

  mode=$(iface_mode "$member")
  addrs=$(ip -4 -j addr show dev "$member" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.scope=="global") | .local+"/"+(.prefixlen|tostring)')
  gw=$(ip -4 -j route show default dev "$member" 2>/dev/null | jq -r '.[0].gateway // empty')
  request=$(printf '%s\n' "$addrs" | sed -n '1p' | cut -d/ -f1)

  for cidr in $addrs; do
    if [ "${LITEFWM_DRY_RUN:-0}" = 1 ]; then
      run_ip addr add "$cidr" dev "$bridge"
    elif ! ip -4 -j addr show dev "$bridge" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.scope=="global") | .local+"/"+(.prefixlen|tostring)' | grep -Fxq "$cidr"; then
      run_ip addr add "$cidr" dev "$bridge" 2>/dev/null || true
    fi
  done
  [ -z "$gw" ] || run_ip route replace default via "$gw" dev "$bridge"

  [ "$mode" != dhcp ] || stop_udhcpc_for_device "$member"
  run_ip link set dev "$member" nomaster 2>/dev/null || true
  run_ip link set dev "$member" master "$bridge"
  run_ip link set dev "$member" up
  for cidr in $addrs; do run_ip addr del "$cidr" dev "$member" 2>/dev/null || true; done

  [ "$mode" != dhcp ] || start_udhcpc_for_device "$bridge" "$request"
}
apply_bridge_members() {
  file=$1
  jq -c '.interfaces[] | select(.managed!=false and .type=="bridge")' "$file" |
  while IFS= read -r b; do
    bridge=$(printf '%s' "$b"|jq -r .device)
    desired=$(printf '%s' "$b"|jq -r '.members[]?')
    printf '%s\n' "$desired" | while IFS= read -r mid; do
      [ -n "$mid" ] || continue
      member=$(device_for_id "$file" "$mid")
      current_master=$(ip -j link show dev "$member" 2>/dev/null | jq -r '.[0].master // empty')
      [ "$current_master" = "$bridge" ] || move_member_l3_to_bridge "$member" "$bridge"
    done
    ip -j link show 2>/dev/null | jq -r --arg b "$bridge" '.[] | select((.master // "")==$b) | .ifname' |
    while IFS= read -r member; do
      [ -n "$member" ] || continue
      keep=false
      for mid in $desired; do
        [ "$(device_for_id "$file" "$mid")" = "$member" ] && keep=true
      done
      [ "$keep" = true ] || run_ip link set dev "$member" nomaster
    done
  done
}

apply_addresses() {
  file=$1
  jq -r '.interfaces[] | select(.managed!=false) | .id' "$file" |
  while IFS= read -r iid; do
    [ -n "$iid" ] || continue
    dev=$(device_for_id "$file" "$iid")
    desired_static=$(jq -r --arg id "$iid" '.segments[] | select(.interface==$id and .addressMode=="static") | .address' "$file")
    dhcp_seg=$(jq -c --arg id "$iid" '[.segments[] | select(.interface==$id and .addressMode=="dhcp")][0] // empty' "$file")

    if [ -n "$dhcp_seg" ]; then
      current=$(printf '%s' "$dhcp_seg" | jq -r '.currentAddress // empty')
      live_cidr=$(ip -4 -j addr show dev "$dev" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.scope=="global") | .local+"/"+(.prefixlen|tostring)' | head -1)
      request=''
      [ -z "$current" ] || request=${current%/*}
      [ -n "$request" ] || { [ -z "$live_cidr" ] || request=${live_cidr%/*}; }
      current_mode=$(iface_mode "$dev")
      if [ "$current_mode" != dhcp ] || ! udhcpc_running_for_device "$dev"; then
        stop_udhcpc_for_device "$dev"
        start_udhcpc_for_device "$dev" "$request"
      fi
    else
      current_mode=$(iface_mode "$dev")
      [ "$current_mode" != dhcp ] || stop_udhcpc_for_device "$dev"
      current=$(ip -4 -j addr show dev "$dev" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.scope=="global") | .local+"/"+(.prefixlen|tostring)')
      for cidr in $current; do
        printf '%s\n' "$desired_static" | grep -Fxq "$cidr" || run_ip addr del "$cidr" dev "$dev" 2>/dev/null || true
      done
    fi

    for cidr in $desired_static; do
      if ! ip -4 -j addr show dev "$dev" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.scope=="global") | .local+"/"+(.prefixlen|tostring)' | grep -Fxq "$cidr"; then
        run_ip addr add "$cidr" dev "$dev"
      fi
    done

    gw=$(jq -r --arg id "$iid" '[.segments[] | select(.interface==$id and (.gateway // "")!="") | .gateway][0] // empty' "$file")
    [ -z "$gw" ] || run_ip route replace default via "$gw" dev "$dev"
  done
}
write_native_interfaces() {
  file=$1
  out=$(mktemp)
  {
    echo 'auto lo'
    echo 'iface lo inet loopback'
    echo
    jq -c '.interfaces[] | select(.managed!=false and .type!="loopback")' "$file" |
    while IFS= read -r obj; do
      iid=$(printf '%s' "$obj"|jq -r .id)
      dev=$(printf '%s' "$obj"|jq -r .device)
      type=$(printf '%s' "$obj"|jq -r .type)
      mtu=$(printf '%s' "$obj"|jq -r '.mtu // 1500')
      dhcp=$(jq -c --arg id "$iid" '[.segments[] | select(.interface==$id and .addressMode=="dhcp")][0] // empty' "$file")
      statics=$(jq -r --arg id "$iid" '.segments[] | select(.interface==$id and .addressMode=="static") | .address' "$file")
      primary=$(printf '%s\n' "$statics" | sed -n '1p')
      member_of=$(jq -r --arg id "$iid" '[.interfaces[] | select(.type=="bridge" and ((.members // [])|index($id))) | .id][0] // empty' "$file")

      echo "auto $dev"
      if [ -n "$member_of" ] && [ -z "$dhcp" ] && [ -z "$primary" ]; then
        echo "iface $dev inet manual"
      elif [ -n "$dhcp" ]; then
        echo "iface $dev inet dhcp"
        req=$(printf '%s' "$dhcp"|jq -r '.currentAddress // empty' | cut -d/ -f1)
        [ -z "$req" ] || echo "    udhcpc_opts -r $req"
      elif [ -n "$primary" ]; then
        echo "iface $dev inet static"
        echo "    address $primary"
        gw=$(jq -r --arg id "$iid" '[.segments[] | select(.interface==$id and (.gateway // "")!="") | .gateway][0] // empty' "$file")
        [ -z "$gw" ] || echo "    gateway $gw"
        dns=$(jq -r --arg id "$iid" '[.segments[] | select(.interface==$id) | .dns[]?] | unique | join(" ")' "$file")
        [ -z "$dns" ] || echo "    dns-nameservers $dns"
      else
        echo "iface $dev inet manual"
      fi
      echo "    pre-up ip link set dev $dev mtu $mtu"

      case "$type" in
        bridge)
          aware=$(printf '%s' "$obj"|jq -r 'if .vlanAware==null then false else .vlanAware end')
          filtering=0; [ "$aware" = true ] && filtering=1
          echo "    pre-up ip link show dev $dev >/dev/null 2>&1 || ip link add name $dev type bridge"
          echo "    pre-up ip link set dev $dev type bridge vlan_filtering $filtering"
          printf '%s' "$obj" | jq -r '.members[]?' |
          while IFS= read -r mid; do
            [ -n "$mid" ] || continue
            mdev=$(device_for_id "$file" "$mid")
            echo "    pre-up ip link set dev $mdev up"
            echo "    pre-up ip link set dev $mdev nomaster >/dev/null 2>&1 || true"
            echo "    pre-up ip link set dev $mdev master $dev"
            echo "    post-down ip link set dev $mdev nomaster >/dev/null 2>&1 || true"
          done
          echo "    post-down ip link delete dev $dev >/dev/null 2>&1 || true"
          ;;
        vlan)
          parent_id=$(printf '%s' "$obj"|jq -r .parent)
          parent=$(device_for_id "$file" "$parent_id")
          vid=$(printf '%s' "$obj"|jq -r .vlanId)
          echo "    pre-up ip link show dev $dev >/dev/null 2>&1 || ip link add link $parent name $dev type vlan id $vid"
          echo "    post-down ip link delete dev $dev >/dev/null 2>&1 || true"
          ;;
      esac

      if [ -n "$primary" ]; then
        printf '%s\n' "$statics" | tail -n +2 |
        while IFS= read -r alias; do
          [ -n "$alias" ] || continue
          echo "    post-up ip addr add $alias dev $dev >/dev/null 2>&1 || true"
          echo "    pre-down ip addr del $alias dev $dev >/dev/null 2>&1 || true"
        done
      fi
      echo
    done
  } > "$out"
  if [ "${LITEFWM_DRY_RUN:-0}" = 1 ]; then
    cat "$out"; rm -f "$out"
  else
    install -m 0644 "$out" "$LITEFWM_INTERFACES"; rm -f "$out"
  fi
}

delete_removed_virtuals() {
  desired=$1
  inventory | jq -r '.[] | select(.persistent==true and (.type=="bridge" or .type=="vlan")) | [.device,.type] | @tsv' |
  while IFS="$(printf '\t')" read -r dev type; do
    [ -n "$dev" ] || continue
    if ! jq -e --arg dev "$dev" '.interfaces[] | select(.managed!=false and .device==$dev)' "$desired" >/dev/null; then
      run_ip link delete dev "$dev" >/dev/null 2>&1 || true
    fi
  done
}

reconcile() {
  [ "$(printenv LITEFWM_DRY_RUN 2>/dev/null || echo 0)" = 1 ] || require_root
  src=$1
  need jq; need ip
  norm=$(mktemp)
  trap 'rm -f "$norm"' EXIT INT TERM
  normalize_desired "$src" "$norm"

  jq -e '
    (.interfaces|type=="array") and (.segments|type=="array") and
    ([.interfaces[] | (.id|type=="string" and length>0) and (.device|type=="string" and length>0)] | all) and
    ([.segments[] | (.interface|type=="string" and length>0) and
      ((.addressMode=="dhcp") or (.addressMode=="static"))] | all)
  ' "$norm" >/dev/null || die "Invalid live network request"

  delete_removed_virtuals "$norm"

  jq -c '.interfaces[] | select(.managed!=false and .type=="physical")' "$norm" |
  while IFS= read -r obj; do
    dev=$(printf '%s' "$obj"|jq -r .device)
    mtu=$(printf '%s' "$obj"|jq -r '.mtu // 1500')
    ip link show dev "$dev" >/dev/null 2>&1 || die "Physical interface not found: $dev"
    run_ip link set dev "$dev" mtu "$mtu"
    run_ip link set dev "$dev" up
  done

  jq -c '.interfaces[] | select(.managed!=false and .type=="bridge")' "$norm" |
  while IFS= read -r obj; do bridge_create_or_update "$norm" "$obj"; done
  jq -c '.interfaces[] | select(.managed!=false and .type=="vlan")' "$norm" |
  while IFS= read -r obj; do vlan_create_or_update "$norm" "$obj"; done

  apply_bridge_members "$norm"
  apply_addresses "$norm"
  write_native_interfaces "$norm"

  [ "${LITEFWM_DRY_RUN:-0}" = 1 ] || rc-update add networking boot >/dev/null 2>&1 || true
}

case "${1:-}" in
  inventory) inventory;;
  interfaces) interfaces_model;;
  segments) segments;;
  reconcile) reconcile "${2:?desired config JSON file}";;
  native) cat "$LITEFWM_INTERFACES";;
  *) echo "Usage: netctl inventory|interfaces|segments|reconcile FILE|native" >&2; exit 2;;
esac
