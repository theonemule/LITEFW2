#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

show_live() {
  interfaces=$("$SELF_DIR/netctl" interfaces)
  segments=$("$SELF_DIR/netctl" segments)
  dhcp=$("$SELF_DIR/dhcpctl" snapshot 2>/dev/null || echo '[]')
  firewall=$("$SELF_DIR/firewallctl" snapshot 2>/dev/null || echo '{"defaults":{"input":"accept","forward":"accept","output":"accept"},"rules":[],"nat":{"masquerade":[],"snat":[],"dnat":[]}}')
  management=$("$SELF_DIR/webctl" snapshot)
  modules=$("$SELF_DIR/modulectl" list 2>/dev/null || echo '[]')
  host=$(hostname)

  segments=$(jq -n --argjson s "$segments" --argjson d "$dhcp" '
    $s | map(. as $seg |
      if .id==.interface then
        ($d | map(select(.interface==$seg.interface))[0] // null) as $dh |
        if $dh==null then .
        else
          .domain=($dh.domain // .domain) |
          .dhcp={
            enabled:true,
            poolStart:$dh.poolStart,poolEnd:$dh.poolEnd,leaseTime:$dh.leaseTime,
            gateway:$dh.gateway,dns:$dh.dns,ntp:$dh.ntp,reservations:$dh.reservations
          }
        end
      else . end
    )')

  modulemap=$(printf '%s' "$modules" | jq 'reduce .[] as $m ({}; .[$m.name]=$m.enabled)')
  jq -n     --arg hostname "$host"     --argjson management "$management"     --argjson interfaces "$interfaces"     --argjson segments "$segments"     --argjson firewall "$firewall"     --argjson modules "$modulemap"     '{version:4,hostname:$hostname,management:$management,interfaces:$interfaces,segments:$segments,firewall:$firewall,modules:$modules}'
}

validate_file() {
  file=$1
  jq -e '
    def dev: type=="string" and test("^[A-Za-z0-9_.:-]{1,63}$");
    def ipv4:
      type=="string" and
      (split(".")|length==4) and
      ([split(".")[] | select(test("^[0-9]{1,3}$")) | tonumber | select(.>=0 and .<=255)] | length==4);
    def cidr:
      type=="string" and
      (split("/")|length==2) and
      (split("/")[0]|ipv4) and
      ((split("/")[1]|tonumber)>=0 and (split("/")[1]|tonumber)<=32);
    def portnum: type=="number" and .>=1 and .<=65535;
    def fwport: type=="string" and test("^(any|[0-9]{1,5}(:[0-9]{1,5})?)$");
    def addr: .=="any" or ipv4 or cidr;

    (.interfaces|type=="array") and
    (.segments|type=="array") and
    (.firewall|type=="object") and
    (.management|type=="object") and
    ((.management.port // 5187)|portnum) and
    ((.management.sshPort // 22)|portnum) and
    ([.interfaces[] |
      (.id|dev) and (.device|dev) and
      ((.type=="physical") or (.type=="bridge") or (.type=="vlan") or (.managed==false)) and
      ((.members // [])|type=="array") and
      ([.members[]? | dev] | all) and
      (((.parent // "")=="") or ((.parent // "")|dev)) and
      (((.vlanId // 1)|type)=="number")
    ] | all) and
    ([.segments[] |
      (.interface|dev) and
      ((.addressMode=="dhcp") or (.addressMode=="static")) and
      (if .addressMode=="static" then (.address|cidr) else true end) and
      (((.gateway // "")=="") or ((.gateway // "")|ipv4)) and
      ([.dns[]? | ipv4] | all)
    ] | all) and
    ([.firewall.rules[]? |
      ((.source // "any")|addr) and
      ((.destination // "any")|addr) and
      ((.sourcePort // "any")|fwport) and
      ((.destinationPort // "any")|fwport)
    ] | all)
  ' "$file" >/dev/null || die "Invalid live configuration request"
}
projection_network() {
  jq -cS '{
    interfaces:[
      .interfaces[] |
      {
        id,device,type,
        managed:(if .managed==null then true else .managed end),
        mtu:(.mtu // 1500),
        enabled:(if .enabled==null then true else .enabled end),
        members:(.members // []),
        vlanAware:(.vlanAware // false),
        parent:(.parent // ""),
        vlanId:(.vlanId // null)
      }
    ],
    segments:[
      .segments[] |
      {
        id,interface,addressMode,
        address:(.address // ""),
        currentAddress:(.currentAddress // ""),
        gateway:(.gateway // ""),
        dns:(.dns // [])
      }
    ]
  }' "$1"
}
projection_dhcp() {
  jq -cS '{segments:[
    .segments[] |
    {
      id,interface,addressMode,
      address:(.address // ""),
      currentAddress:(.currentAddress // ""),
      dns:(.dns // []),
      domain:(.domain // ""),
      dhcp:(.dhcp // {enabled:false,dns:[],ntp:[],reservations:[]})
    }
  ]}' "$1"
}
projection_web() {
  jq -cS '{hostname,management:{
    port:(.management.port // 5187),
    sshPort:(.management.sshPort // 22),
    allowSsh:(if .management.allowSsh==null then true else .management.allowSsh end)
  }}' "$1"
}

set_live() {
  require_root
  desired=$1
  validate_file "$desired"
  current=$(mktemp)
  trap 'rm -f "$current"' EXIT INT TERM
  show_live > "$current"

  cnet=$(projection_network "$current")
  dnet=$(projection_network "$desired")
  if [ "$cnet" != "$dnet" ]; then
    "$SELF_DIR/netctl" reconcile "$desired"
  fi

  cdh=$(projection_dhcp "$current")
  ddh=$(projection_dhcp "$desired")
  if [ "$cdh" != "$ddh" ]; then
    "$SELF_DIR/dhcpctl" reconcile "$desired"
  fi

  cfw=$(jq -cS '.firewall' "$current")
  dfw=$(jq -cS '.firewall' "$desired")
  if [ "$cfw" != "$dfw" ]; then
    "$SELF_DIR/firewallctl" reconcile "$desired"
  fi

  cweb=$(projection_web "$current")
  dweb=$(projection_web "$desired")
  if [ "$cweb" != "$dweb" ]; then
    "$SELF_DIR/webctl" reconcile "$desired"
  fi

  show_live
}

case "${1:-}" in
  show) show_live;;
  validate) validate_file "${2:?FILE}"; echo "Live request is structurally valid.";;
  set) set_live "${2:?FILE}";;
  *) echo "Usage: configctl show|validate FILE|set FILE" >&2; exit 2;;
esac
