#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi
require_root

with_live() {
  tmp=$(mktemp)
  "$SELF_DIR/configctl" show > "$tmp"
  printf '%s\n' "$tmp"
}

commit_live() {
  tmp=$1
  "$SELF_DIR/configctl" validate "$tmp" >/dev/null
  "$SELF_DIR/configctl" set "$tmp" >/dev/null
  rm -f "$tmp"
}

case "${1:-}" in
  show) "$SELF_DIR/configctl" show;;
  inventory) "$SELF_DIR/netctl" inventory;;
  bridge)
    id=${2:?ID}; dev=${3:?DEVICE}; members=${4:-}; aware=${5:-true}
    tmp=$(with_live); out=$(mktemp)
    jq --arg id "$id" --arg dev "$dev" --arg members "$members" --argjson aware "$aware" '
      .interfaces = ([.interfaces[] | select(.id!=$id)] + [{
        id:$id,name:$id,type:"bridge",kind:"bridge",device:$dev,managed:true,persistent:true,
        enabled:true,mtu:1500,vlanAware:$aware,members:($members|split(",")|map(select(length>0)))
      }])
    ' "$tmp" > "$out"; rm -f "$tmp"; commit_live "$out"
    ;;
  vlan)
    id=${2:?ID}; parent=${3:?PARENT}; vid=${4:?VLAN_ID}; dev=${5:-}
    [ -n "$dev" ] || dev="$parent.$vid"
    tmp=$(with_live); out=$(mktemp)
    jq --arg id "$id" --arg parent "$parent" --arg dev "$dev" --argjson vid "$vid" '
      .interfaces = ([.interfaces[] | select(.id!=$id)] + [{
        id:$id,name:$id,type:"vlan",kind:"vlan",device:$dev,parent:$parent,vlanId:$vid,
        managed:true,persistent:true,enabled:true,mtu:1500,members:[]
      }])
    ' "$tmp" > "$out"; rm -f "$tmp"; commit_live "$out"
    ;;
  segment-static)
    id=${2:?ID}; iface=${3:?INTERFACE}; cidr=${4:?CIDR}; gateway=${5:-}; dns=${6:-}; domain=${7:-}
    tmp=$(with_live); out=$(mktemp)
    jq --arg id "$id" --arg iface "$iface" --arg cidr "$cidr" --arg gateway "$gateway" --arg dns "$dns" --arg domain "$domain" '
      .segments = ([.segments[] | select(.id!=$id)] + [{
        id:$id,name:$id,interface:$iface,zone:(if $gateway=="" then "internal" else "external" end),
        addressMode:"static",address:$cidr,currentAddress:$cidr,gateway:$gateway,
        dns:($dns|split(",")|map(select(length>0))),domain:$domain,dhcpClient:{hostname:""},
        dhcp:{enabled:false,dns:[],ntp:[],reservations:[]},managed:true
      }])
    ' "$tmp" > "$out"; rm -f "$tmp"; commit_live "$out"
    ;;
  segment-dhcp)
    id=${2:?ID}; iface=${3:?INTERFACE}
    tmp=$(with_live); out=$(mktemp)
    jq --arg id "$id" --arg iface "$iface" '
      .segments = ([.segments[] | select(.id!=$id)] + [{
        id:$id,name:$id,interface:$iface,zone:"external",addressMode:"dhcp",address:"",
        currentAddress:"",gateway:"",dns:[],domain:"",dhcpClient:{hostname:""},
        dhcp:{enabled:false,dns:[],ntp:[],reservations:[]},managed:true
      }])
    ' "$tmp" > "$out"; rm -f "$tmp"; commit_live "$out"
    ;;
  dhcp)
    id=${2:?SEGMENT}; enabled=${3:?true_or_false}; start=${4:-}; end=${5:-}; lease=${6:-12h}
    router=${7:-}; dns=${8:-}; domain=${9:-}; ntp=${10:-}
    tmp=$(with_live); out=$(mktemp)
    jq --arg id "$id" --argjson enabled "$enabled" --arg start "$start" --arg end "$end" \
       --arg lease "$lease" --arg router "$router" --arg dns "$dns" --arg domain "$domain" --arg ntp "$ntp" '
      .segments |= map(if .id==$id then
        .domain=$domain |
        .dhcp={enabled:$enabled,poolStart:$start,poolEnd:$end,leaseTime:$lease,gateway:$router,
          dns:($dns|split(",")|map(select(length>0))),
          ntp:($ntp|split(",")|map(select(length>0))),
          reservations:(.dhcp.reservations // [])}
      else . end)
    ' "$tmp" > "$out"; rm -f "$tmp"; commit_live "$out"
    ;;
  management)
    port=${2:-5187}
    tmp=$(with_live); out=$(mktemp)
    jq --argjson port "$port" '.management.port=$port' "$tmp" > "$out"
    rm -f "$tmp"; commit_live "$out"
    ;;
  ssh)
    enabled=${2:?true_or_false}; port=${3:-22}
    tmp=$(with_live); out=$(mktemp)
    jq --argjson enabled "$enabled" --argjson port "$port" \
       '.management.allowSsh=$enabled | .management.sshPort=$port' "$tmp" > "$out"
    rm -f "$tmp"; commit_live "$out"
    ;;
  apply)
    echo "Nothing is staged. LiteFWM changes the live system immediately."
    ;;
  *)
    cat >&2 <<'TXT'
Usage:
  setupctl inventory
  setupctl show
  setupctl bridge ID DEVICE [MEMBER_IDS_CSV] [true|false]
  setupctl vlan ID PARENT_ID VLAN_ID [DEVICE]
  setupctl segment-static ID INTERFACE CIDR [GATEWAY] [DNS_CSV] [DOMAIN]
  setupctl segment-dhcp ID INTERFACE
  setupctl dhcp SEGMENT true|false [POOL_START] [POOL_END] [LEASE] [ROUTER] [DNS_CSV] [DOMAIN] [NTP_CSV]
  setupctl management [PORT]
  setupctl ssh true|false [PORT]
TXT
    exit 2;;
esac
