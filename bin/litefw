POST  /api/segments/set  - Configure network segments
GET   /api/state  - Legacy combined state snapshot
GET   /api/system  - Appliance settings and status
GET   /api/system/api-keys  - List API key metadata (no secret material)
POST  /api/system/api-keys/create  - Create an API key (secret displayed once; Basic only)
POST  /api/system/api-keys/revoke  - Revoke an API key immediately (Basic only)
POST  /api/system/diagnostics/lookup  - DNS lookup
POST  /api/system/diagnostics/ping  - Ping test
POST  /api/system/logging  - Configure logging
POST  /api/system/management  - Configure management access (Basic credentials only)
POST  /api/system/packages/check  - Check Alpine package updates
POST  /api/system/packages/upgrade  - Upgrade Alpine packages
POST  /api/system/password  - Change administrator password (Basic credentials only)
POST  /api/system/set  - Change general system settings
POST  /api/system/telemetry  - Configure telemetry exporters
POST  /api/system/updates/check  - Check LiteFW releases
POST  /api/system/updates/install  - Install verified LiteFW runtime release
POST  /api/system/updates/upload  - Upload runtime bundle
GET   /api/telemetry  - Telemetry exporter settings
GET   /api/telemetry/metrics  - Prometheus text metrics
LITEFW_EMBEDDED_ENDPOINTS
}
# GENERATED_HELP_END

action=${1:-help}
[ "$#" -eq 0 ] || shift
case "$action" in
  login)
    server=${1:-}; [ -n "$server" ] || die 'Usage: litefw login URL --api-key|--basic [user] [--allow-http]'
    shift
    mode="" user="" allow_http=no
    for arg in "$@"; do
      case "$arg" in
        --api-key) mode=key;;
        --basic) mode=basic;;
        --allow-http) allow_http=yes;;
        *) [ "$mode" = basic ] && [ -z "$user" ] || die "Unexpected argument: $arg"; user=$arg;;
      esac
    done
    [ -n "$mode" ] || die 'Specify --api-key or --basic'
    case "$server" in https://*) :;; http://*) [ "$allow_http" = yes ] || die 'HTTP exposes credentials; use HTTPS or explicitly --allow-http on a trusted LAN';; *) die 'URL must be HTTP or HTTPS';; esac
    case "$server" in *[[:space:]]*|*'@'*|*'?'*|*'#'*) die 'URL must be a base URL without userinfo/query';; esac
    if [ "$mode" = basic ] && [ -z "$user" ]; then
      printf 'Username: ' >&2; IFS= read -r user || :
    fi
    if [ "$mode" = key ]; then secret=$(read_secret 'API key'); else secret=$(read_secret 'Password'); fi
    LITEFW_URL="$server"; LITEFW_AUTH_MODE="$mode"; LITEFW_USER="$user"
    if [ "$mode" = key ]; then LITEFW_API_KEY="$secret"; else LITEFW_PASSWORD="$secret"; fi
    export LITEFW_URL LITEFW_AUTH_MODE LITEFW_USER LITEFW_API_KEY LITEFW_PASSWORD
    SILENT_RESPONSE=yes; api_request GET /identity
    [ ! -L "$CONFIG_DIR" ] && [ ! -L "$CONFIG" ] || die 'Refusing symlinked credentials path'
    mkdir -p "$CONFIG_DIR"
    chmod 0700 "$CONFIG_DIR"
    mktempdir
    printf 'url=%s\nmode=%s\nuser=%s\nsecret=%s\n' "$server" "$mode" "$user" "$secret" >"$tmp/config"
    chmod 0600 "$tmp/config"
    mv "$tmp/config" "$CONFIG"
    echo "Logged in to $server ($mode). Saved credentials with permissions 0600."
    ;;
  logout)
    [ ! -L "$CONFIG" ] || die 'Refusing symlinked credential file'
    rm -f "$CONFIG"
    echo 'Local credentials cleared.'
    ;;
  whoami) api_request GET /identity;;
  get) [ "$#" -eq 1 ] || die 'Usage: litefw get /resource'; api_request GET "$1";;
  post) [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'Usage: litefw post /resource [JSON|@file|-]'; api_request POST "$1" "${2:-}";;
  op)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'Usage: litefw op family.action [JSON|@file|-]'
    printf '%s' "$1" | grep -Eq '^[a-z]+\.[a-z]+$' || die 'Invalid operation'
    api_request POST "/op/$1" "${2:-}";;
  module)
    [ "$#" -ge 2 ] || die 'Usage: litefw module show|install|remove|start|stop|restart ID'
    verb=$1 id=$2
    printf '%s' "$id" | grep -Eq '^[a-z0-9_-]{1,32}$' || die 'Invalid module ID'
    case "$verb" in
      show) api_request GET "/modules/$id";;
      install|remove) api_request POST "/modules/$id/$verb";;
      start|stop|restart) api_request POST "/modules/$id/service" "{\"action\":\"$verb\"}";;
      *) die 'Unknown module action';;
    esac
    ;;
  upload)
    [ "$#" -eq 1 ] || die 'Usage: litefw upload /path/to/runtime.tar.gz'
    api_request POSTBINARY /system/updates/upload "$1";;
  api|endpoints) print_api_catalog;;
  help|-h|--help) print_help;;
  --version|version) print_version;;
  *) die "Unknown command: $action. Try litefw help";;
esac
