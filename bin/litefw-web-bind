#!/bin/sh
# Bind lighttpd only to IPv4 addresses on interfaces assigned the LAN role.
# No LAN => loopback only. Generated natively from live kernel ifalias + IPs.
set -eu
PATH=${LITEFW_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
sysnet=${LITEFW_SYS_NET:-/sys/class/net}
conf=${LFW_LIGHTTPD_CONF:-/etc/lighttpd/litefwm.conf}
output=${LFW_LIGHTTPD_BIND_CONF:-/etc/lighttpd/litefwm-bind.conf}
port=$(sed -n 's/^[[:space:]]*server\.port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$conf" | head -1)
port=${port:-80}
case "$port" in ''|*[!0-9]*) echo "Invalid web management port" >&2; exit 1;; esac
ips=$(
  for p in "$sysnet"/*; do
    [ -e "$p" ] || continue
    iface=${p##*/}
    alias=$(cat "$p/ifalias" 2>/dev/null || true)
    case "$alias" in 'lfw:role=lan;'*) :;; *) continue;; esac
    ip -4 -o addr show dev "$iface" scope global 2>/dev/null |
      awk '$3=="inet" {split($4,x,"/"); print x[1]}'
  done | sort -u
)
first=$(printf '%s\n' "$ips" | sed -n '/./{p;q;}')
first=${first:-127.0.0.1}
dir=${output%/*}
mkdir -p "$dir"
temp=$(mktemp "$dir/.litefwm-bind.XXXXXX")
trap 'rm -f "$temp"' EXIT HUP INT TERM
{
  echo '# Generated by litefw-web-bind; listen only on LAN addresses.'
  printf 'server.bind = "%s"\n' "$first"
  for address in $ips; do
    [ "$address" = "$first" ] && continue
    printf '$SERVER["socket"] == "%s:%s" { }\n' "$address" "$port"
  done
} >"$temp"
chmod 0644 "$temp"
mv -f "$temp" "$output"
trap - EXIT HUP INT TERM
