#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -r "$SELF_DIR/../lib/common.sh" ]; then . "$SELF_DIR/../lib/common.sh"; else . /usr/lib/litefwm/common.sh; fi

NAMES="openvpn tailscale bind squid snort haproxy ddns"
module_service() {
  case "$1" in bind) echo named;; ddns) echo ddclient;; *) echo "$1";; esac
}
native_config() {
  case "$1" in
    openvpn) echo /etc/openvpn/openvpn.conf;;
    tailscale) echo /var/lib/tailscale/tailscaled.state;;
    bind) echo /etc/bind/named.conf;;
    squid) echo /etc/squid/squid.conf;;
    snort) [ -e /etc/snort/snort.lua ] && echo /etc/snort/snort.lua || echo /etc/snort/snort.conf;;
    haproxy) echo /etc/haproxy/haproxy.cfg;;
    ddns) echo /etc/ddclient/ddclient.conf;;
  esac
}
install_packages() {
  case "$1" in
    ddns) apk add --no-cache ddclient ddclient-openrc;;
    openvpn) apk add --no-cache openvpn openvpn-openrc;;
    tailscale) apk add --no-cache tailscale tailscale-openrc;;
    bind) apk add --no-cache bind bind-openrc;;
    squid) apk add --no-cache squid squid-openrc;;
    haproxy) apk add --no-cache haproxy haproxy-openrc;;
    snort) apk add --no-cache snort; apk add --no-cache snort-openrc >/dev/null 2>&1 || true;;
    *) die "Unknown module: $1";;
  esac
}
remove_packages() {
  case "$1" in
    ddns) apk del ddclient-openrc ddclient >/dev/null 2>&1 || true;;
    openvpn) apk del openvpn-openrc openvpn >/dev/null 2>&1 || true;;
    tailscale) apk del tailscale-openrc tailscale >/dev/null 2>&1 || true;;
    bind) apk del bind-openrc bind >/dev/null 2>&1 || true;;
    squid) apk del squid-openrc squid >/dev/null 2>&1 || true;;
    haproxy) apk del haproxy-openrc haproxy >/dev/null 2>&1 || true;;
    snort) apk del snort-openrc snort >/dev/null 2>&1 || apk del snort >/dev/null 2>&1 || true;;
    *) die "Unknown module: $1";;
  esac
}
enabled_service() {
  svc=$1
  rc-update show default 2>/dev/null | awk '{print $1}' | grep -Fxq "$svc"
}
list_modules() {
  for name in $NAMES; do
    installed=false; module_installed "$name" && installed=true
    svc=$(module_service "$name")
    running=false; rc-service "$svc" status >/dev/null 2>&1 && running=true
    enabled=false; enabled_service "$svc" && enabled=true
    cfg=$(native_config "$name")
    configured=false; [ -s "$cfg" ] && configured=true
    jq -n --arg name "$name" --arg configPath "$cfg" --argjson installed "$installed"       --argjson running "$running" --argjson enabled "$enabled" --argjson configured "$configured"       '{name:$name,installed:$installed,running:$running,enabled:$enabled,configured:$configured,configPath:$configPath}'
  done | jq -s .
}
case "${1:-}" in
  list) list_modules;;
  install)
    require_root; mod=${2:?MODULE}; install_packages "$mod"
    "$SELF_DIR/modulecfgctl" init "$mod" >/dev/null 2>&1 || true
    echo "$mod installed."
    ;;
  remove)
    require_root; mod=${2:?MODULE}; svc=$(module_service "$mod")
    rc-service "$svc" stop >/dev/null 2>&1 || true
    rc-update del "$svc" default >/dev/null 2>&1 || true
    remove_packages "$mod"
    echo "$mod removed."
    ;;
  enable)
    require_root; mod=${2:?MODULE}; svc=$(module_service "$mod")
    rc-update add "$svc" default >/dev/null 2>&1 || true
    rc-service "$svc" start >/dev/null 2>&1 || true
    ;;
  disable)
    require_root; mod=${2:?MODULE}; svc=$(module_service "$mod")
    rc-service "$svc" stop >/dev/null 2>&1 || true
    rc-update del "$svc" default >/dev/null 2>&1 || true
    ;;
  *) echo "Usage: modulectl list|install|remove|enable|disable [module]" >&2; exit 2;;
esac
