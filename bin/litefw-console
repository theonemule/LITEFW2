#!/bin/sh
# pfSense-style local LiteFW appliance management console.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
VERSION=$(cat /usr/lib/litefwm/VERSION 2>/dev/null || echo unknown)
installed() {
  [ -e /etc/litefwm/installed ] && return 0
  fs=$(awk '$2=="/" {print $3; exit}' /proc/mounts 2>/dev/null)
  case "$fs" in ext2|ext3|ext4|xfs|btrfs|f2fs|zfs|ubifs) return 0;; esac
  return 1
}
while :; do
  clear 2>/dev/null || true
  echo '======================================================'
  printf '                   LiteFW  v%s\n' "$VERSION"
  echo '             Firewall & Network Appliance'
  echo '======================================================'
  echo
  if [ -s /etc/litefwm/htpasswd ]; then
    echo 'Web UI: configured (LAN only)'
  else
    echo 'Web UI: administrator setup required'
  fi
  ip -4 -brief address 2>/dev/null || true
  echo
  if /usr/sbin/litefw-ssh-access status >/dev/null 2>&1; then
    echo 'Temporary root SSH password login: ENABLED (disable from this menu)'
  else
    echo 'Temporary root SSH password login: OFF'
  fi
  echo
  if installed; then
    mode=installed
    echo '  1) Assign WAN / LAN interfaces (optional LAN VLAN)'
    echo '  2) Set or reset web administrator username/password'
    echo '  3) Show network status'
    echo '  4) Alpine keyboard / timezone / repository settings'
    echo '  5) Restart LAN-only web management service'
    echo '  6) Open system shell'
    echo '  7) Enable temporary root SSH access (set password)'
    echo '  8) Disable temporary root SSH access (no reboot)'
    echo '  9) Reboot'
    echo ' 10) Shut down'
  else
    mode=live
    echo '  1) Install LiteFW to disk (Alpine + appliance setup)'
    echo '  2) Assign WAN / LAN interfaces (optional LAN VLAN)'
    echo '  3) Set or reset web administrator username/password'
    echo '  4) Show network status'
    echo '  5) Alpine keyboard / timezone / repository settings'
    echo '  6) Restart LAN-only web management service'
    echo '  7) Open system shell'
    echo '  8) Enable temporary root SSH access (set password)'
    echo '  9) Disable temporary root SSH access (no reboot)'
    echo ' 10) Reboot'
    echo ' 11) Shut down'
  fi
  echo
  printf 'Select an option: '
  IFS= read -r answer || exit 0
  if [ "$mode" = installed ]; then
    case "$answer" in [1-9]|10) answer=$((answer + 1));; *) answer=invalid;; esac
  fi
  case "$answer" in
    1)
      if [ "$mode" = live ]; then /usr/local/sbin/setup-alpine; fi;;
    2) /usr/sbin/litefw-network;;
    3) /usr/sbin/litefw-admin;;
    4) /usr/sbin/lfw-setup show; ip route show;;
    5)
      echo '1) Keyboard  2) Timezone  3) APK repositories'
      printf 'Select setting: '; IFS= read -r item || exit 0
      case "$item" in
        1) setup-keymap;;
        2) setup-timezone;;
        3) setup-apkrepos;;
      esac;;
    6) /usr/sbin/litefw-web-bind && rc-service lighttpd restart;;
    7) echo 'Type exit to return to LiteFW console.'; /bin/sh;;
    8) /usr/sbin/litefw-ssh-access enable;;
    9) /usr/sbin/litefw-ssh-access disable;;
    10) reboot;;
    11) poweroff;;
    *) echo 'Invalid selection.';;
  esac
  printf '\nPress Enter to return to LiteFW console...'
  IFS= read -r unused || exit 0
done