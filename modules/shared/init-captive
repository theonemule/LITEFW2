#!/sbin/openrc-run
description="LiteFW guest captive portal"
command="/usr/local/bin/opennds"
command_args="-f -c /etc/opennds/opennds.conf"
command_background="yes"
pidfile="/run/opennds.pid"
depend() { need net; after iptables; }
start_pre() { [ -s /etc/opennds/opennds.conf ] && [ -x "$command" ]; }
