#!/sbin/openrc-run
description="LiteFW Suricata IDS/IPS (explicitly enabled)"
command="/usr/bin/suricata"
command_background="yes"
pidfile="/run/litefw-suricata.pid"
depend() { need net; after iptables; }
start_pre() {
  [ -r /etc/conf.d/litefw-suricata ] || { eerror "Configure Suricata in LiteFW first"; return 1; }
  . /etc/conf.d/litefw-suricata
  [ -n "$SURICATA_IFACE" ] && [ -n "$SURICATA_MODE" ] || return 1
  command_args="-c /etc/suricata/suricata.yaml --pidfile $pidfile"
  if [ "$SURICATA_MODE" = "ids" ]; then
    command_args="$command_args -i $SURICATA_IFACE"
  elif [ "$SURICATA_MODE" = "ips" ]; then
    command_args="$command_args -q 0"
  else return 1; fi
  /usr/bin/suricata -T -c /etc/suricata/suricata.yaml >/dev/null
}