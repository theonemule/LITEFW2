#!/sbin/openrc-run
description="Restore LiteFW CrowdSec IP sets before iptables"
depend() { before iptables; }
start() {
  ebegin "Restore LiteFW CrowdSec blocklist"
  ipset create litefw_cs4 hash:net family inet maxelem 300000 -exist || return 1
  if [ -s /etc/litefw-addons/crowdsec.ipset ]; then
    ipset flush litefw_cs4 || return 1
    ipset restore -exist </etc/litefw-addons/crowdsec.ipset || return 1
  fi
  eend $?
}
stop() { return 0; }
