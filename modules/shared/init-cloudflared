#!/sbin/openrc-run
description="LiteFW outbound Cloudflare Tunnel"
command="/usr/local/bin/cloudflared"
command_args="tunnel --no-autoupdate run --token-file /etc/cloudflared/litefw-token"
command_background="yes"
pidfile="/run/litefw-cloudflared.pid"
depend() { need net; after firewall; }
start_pre() { [ -s /etc/cloudflared/litefw-token ]; }
